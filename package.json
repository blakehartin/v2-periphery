{
  "name": "@quantumswap/v2-periphery",
  "version": "1.0.0",
  "description": "Peripheral smart contracts for interacting with QuantumSwap V2 on the QuantumCoin blockchain (modified fork of @uniswap/v2-periphery)",
  "license": "GPL-3.0-or-later",
  "files": [
    "contracts",
    "!contracts/test",
    "!contracts/examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumswapdex/v2-periphery.git"
  },
  "homepage": "https://github.com/quantumswapdex/v2-periphery#readme",
  "bugs": {
    "url": "https://github.com/quantumswapdex/v2-periphery/issues"
  },
  "keywords": [
    "quantumswap",
    "quantumcoin",
    "v2",
    "periphery",
    "quantumswap-v2"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "node scripts/compile.js",
    "test": "npm run compile && node scripts/devnet.js ensure && node --test --test-concurrency=1",
    "prepublishOnly": "npm run compile"
  },
  "dependencies": {
    "@quantumcoin/solidity-lib": "file:../../solidity-lib",
    "@quantumswap/v2-core": "file:../v2-core"
  },
  "devDependencies": {
    "@quantumcoin/solc": "^0.7.6",
    "@quantumcoin/wq": "file:../../wq",
    "quantumcoin": "^8.0.2"
  }
}
